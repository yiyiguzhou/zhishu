page {
  background: #f5f5f5;
  font-family: -apple-system, "Helvetica Neue", Helvetica, Arial, sans-serif;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.text-ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}