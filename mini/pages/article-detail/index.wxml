<view class="page">
  <view class="card">
    <view class="a-title">{{detail.title}}</view>
    <view class="a-meta">{{detail.authorName}}<text wx:if="{{detail.publishedAt}}"> · {{detail.publishedAt}}</text></view>
    <view wx:if="{{detail.summary}}" class="a-summary">{{detail.summary}}</view>
    <rich-text class="a-content" nodes="{{detail.contentHtml}}"></rich-text>
  </view>
</view>