.page { padding: 20rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 30rpx; }
.a-title { font-size: 36rpx; font-weight: 600; line-height: 1.4; }
.a-meta { font-size: 24rpx; color: #999; margin: 16rpx 0; }
.a-summary { background: #f5f7fa; border-left: 8rpx solid #1677ff; padding: 20rpx; border-radius: 8rpx; color: #666; font-size: 26rpx; line-height: 1.6; margin-bottom: 24rpx; }
.a-content { font-size: 28rpx; line-height: 1.7; color: #333; }