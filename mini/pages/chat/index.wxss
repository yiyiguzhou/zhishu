.chat-page { display: flex; flex-direction: column; height: 100vh; background: #f5f6f8; }

.msg-list { flex: 1; padding: 24rpx; box-sizing: border-box; }

.msg-row { display: flex; margin-bottom: 24rpx; }
.msg-user { justify-content: flex-end; }
.msg-ai { justify-content: flex-start; }

.bubble { max-width: 520rpx; padding: 16rpx 24rpx; border-radius: 16rpx; font-size: 28rpx; line-height: 1.5; word-break: break-all; }
.bubble.user { background: #1677ff; color: #fff; }
.bubble.assistant { background: #fff; color: #333; }

.input-bar {
  display: flex; align-items: center; gap: 16rpx;
  padding: 16rpx 24rpx; background: #fff;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #eee;
}
.input { flex: 1; background: #f5f5f5; border-radius: 32rpx; padding: 12rpx 24rpx; font-size: 28rpx; }
.send-btn { margin: 0; }
