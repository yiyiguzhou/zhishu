.page { padding: 20rpx; }
.center { text-align: center; padding: 60rpx 0; }
.hello { font-size: 30rpx; color: #666; }
.btn { border-radius: 12rpx; font-size: 30rpx; }
.btn.primary { background: #1677ff; color: #fff; }
.btn.ghost { margin: 30rpx 20rpx; background: #fff; color: #666; border: 1rpx solid #e0e0e0; }

.profile { display: flex; align-items: center; }
.avatar { width: 120rpx; height: 120rpx; border-radius: 50%; background: #eee; }
.p-right { margin-left: 30rpx; }
.p-name { font-size: 34rpx; font-weight: 600; }
.p-meta { font-size: 24rpx; color: #999; margin-top: 6rpx; }

.entry { display: flex; justify-content: space-between; align-items: center; padding: 26rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.entry:last-child { border-bottom: none; }
.entry-left { font-size: 30rpx; }
.entry-icon { margin-right: 8rpx; }
.entry-arrow { color: #999; font-size: 26rpx; }