.page { padding: 20rpx; }
.author-bar { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 0; }
.author-left { display: flex; align-items: center; }
.avatar { width: 88rpx; height: 88rpx; border-radius: 50%; background: #eee; margin-right: 20rpx; }
.author-name { font-size: 32rpx; font-weight: 600; }
.author-fav { font-size: 22rpx; color: #999; margin-top: 4rpx; }
.fav-btn { font-size: 26rpx; color: #fff; background: #1677ff; padding: 12rpx 24rpx; border-radius: 30rpx; }
.fav-btn.fav-active { background: #ff4d4f; }

.player { width: 100%; height: 420rpx; background: #000; border-radius: 12rpx; }

.title-block { margin-top: 20rpx; }
.detail-title { font-size: 32rpx; font-weight: 600; }
.detail-meta { font-size: 24rpx; color: #999; margin-top: 10rpx; }
.tag-row { margin-top: 16rpx; display: flex; flex-wrap: wrap; }
.tag-chip { font-size: 24rpx; color: #1677ff; background: #e6f4ff; padding: 6rpx 16rpx; border-radius: 24rpx; margin-right: 12rpx; margin-bottom: 8rpx; }