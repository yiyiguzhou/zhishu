.page { padding: 20rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 24rpx; }
.section-title { font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; }
.article-card { display: flex; padding: 16rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.article-cover { width: 200rpx; height: 120rpx; border-radius: 8rpx; background: #eee; flex-shrink: 0; }
.article-info { flex: 1; margin-left: 20rpx; overflow: hidden; }
.article-title { font-size: 28rpx; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.article-meta { font-size: 24rpx; color: #999; margin-top: 8rpx; }
.article-summary { font-size: 24rpx; color: #666; margin-top: 8rpx; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.loading, .empty { text-align: center; color: #999; padding: 20rpx; }