.page { padding: 60rpx 40rpx; }
.title { font-size: 36rpx; font-weight: 600; text-align: center; }
.hint { font-size: 24rpx; color: #999; text-align: center; margin: 16rpx 0 40rpx; }
.input { background: #f5f6f7; border-radius: 12rpx; padding: 24rpx; font-size: 28rpx; margin-bottom: 24rpx; }
.code-row { display: flex; align-items: center; }
.code-input { flex: 1; margin-bottom: 24rpx; margin-right: 16rpx; }
.btn { margin-top: 16rpx; border-radius: 12rpx; font-size: 30rpx; }
.btn.primary { background: #1677ff; color: #fff; }
.btn.ghost { background: #fff; color: #1677ff; border: 1rpx solid #1677ff; }
.btn.wechat { background: #07c160; color: #fff; }
.divider { text-align: center; color: #999; margin: 30rpx 0; font-size: 24rpx; }