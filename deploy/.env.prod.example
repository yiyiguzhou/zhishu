# 线上环境变量模板：复制为 .env.prod 后按实际填写（.env.prod 已在 .gitignore，不会入库）
# 用法：cp deploy/.env.prod.example deploy/.env.prod

# ---- Nacos 鉴权 token：重新生成，命令：openssl rand -base64 48 ----
NACOS_AUTH_TOKEN=请替换为openssl-rand-base64-48的输出

# ---- Nacos 控制台（后端连接用；控制台首次登录后请改掉 nacos/nacos 默认密码）----
NACOS_USERNAME=nacos
NACOS_PASSWORD=请替换为强密码

# ---- MySQL（推荐 RDS 内网地址；useSSL=true）----
MYSQL_URL='jdbc:mysql://rm-xxxx.mysql.rds.aliyuncs.com:3306/zhishu?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=true'
MYSQL_USER=zhishu
MYSQL_PASSWORD=请替换为强密码

# ---- JWT（线上必须更换：openssl rand -base64 48）----
JWT_SECRET=请替换为随机密钥

# ---- Redis（验证码/锁/缓存）----
# 单机模式自动起 redis 容器，REDIS_PASSWORD 同时用于容器 requirepass 与后端连接。
# 用云 Redis 时：COMPOSE_PROFILES="" 并把 REDIS_HOST_INTERNAL 指向 VPC 地址。
REDIS_PASSWORD=请替换为强密码
# REDIS_HOST_INTERNAL=r-xxxx.redis.rds.aliyuncs.com
# REDIS_PORT_INTERNAL=6379
# Nacos 同理（集群/云托管时取消注释）：
# NACOS_SERVER_ADDR_INTERNAL=nacos-cluster-vip:8848

# ---- Nacos 集群专用：集群 MySQL（nacos_config 库）root 密码；
# 使用 deploy/nacos/docker-compose.cluster.yml 时必填 ----
NACOS_MYSQL_PASSWORD=请替换为强密码

# ---- 视频源：mode=oss（阿里云 OSS）；endpoint 必须是客户端可访问的对外地址 ----
MEDIA_MODE=oss
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_ACCESS_KEY=请替换为RAM用户AK
OSS_SECRET_KEY=请替换为RAM用户SK
OSS_BUCKET=zhishu-video-ai
# 如暂时沿用 MinIO：MEDIA_MODE=minio 并改用 MINIO_* 变量
# MINIO_ENDPOINT=https://video.your-domain.com
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=zhishu-video

# ---- 微信小程序（为空时 code2session 返回 mock openid，正式上线必须填写）----
WX_APP_ID=
WX_SECRET=

# ---- 火山方舟学习助手（变量名对应 ${spring.ai.openai.api-key}；也可放 Nacos，二选一）----
SPRING_AI_OPENAI_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=deepseek-v4-flash-260425

# ---- 网页正文抓取（域名白名单防 SSRF；线上 ECS 内存小，JS 渲染保持 false）----
CRAWLER_ALLOWED_DOMAINS=ruanyifeng.com,mp.weixin.qq.com,sspai.com,36kr.com
CRAWLER_RENDER_ENABLED=false

# ---- 日志级别：线上用 info ----
LOG_LEVEL=info

# ---- 仅 --profile local-mysql 同机 MySQL 时使用 ----
MYSQL_DB=zhishu
